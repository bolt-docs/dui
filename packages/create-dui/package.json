{
	"name": "create-dui",
	"version": "0.1.0",
	"description": "Scaffold a new CLI project pre-wired with @bdocs/dui — banner, box, spinner, prompts and theme included.",
	"bin": {
		"create-dui": "./dist/cli.mjs"
	},
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"dev": "tsdown --watch --config-loader unrun",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bolt-docs/dui.git"
	},
	"keywords": [
		"scaffold",
		"cli",
		"terminal",
		"boilerplate",
		"create"
	],
	"packageManager": "pnpm@10.30.2",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@bdocs/dui": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.21.7",
		"typescript": "^5.9.3",
		"vitest": "^3.0.0"
	}
}

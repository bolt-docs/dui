{
	"name": "@dui-toolkit/plugin-notify",
	"version": "0.1.0",
	"description": "Cross-platform desktop notifications and inline TUI toasts for @bdocs/dui — auto-routes between OS spawn, OSC escape sequences, and box-rendered toasts depending on the host environment.",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"dev": "tsdown --watch --config-loader unrun",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bolt-docs/dui.git"
	},
	"keywords": [
		"terminal",
		"cli",
		"notification",
		"os-notification",
		"toast",
		"bell",
		"osc",
		"libnotify",
		"iterm",
		"kitty",
		"ansi"
	],
	"packageManager": "pnpm@10.30.2",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@bdocs/dui": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.21.7",
		"typescript": "^5.9.3",
		"vitest": "^3.0.0"
	}
}
